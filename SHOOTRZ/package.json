{
  "name": "shootrz-basketball-training",
  "version": "1.0.0",
  "description": "AI-Powered Basketball Training Assistant - Perfect the Game",
  "author": "SHOOTRZ Team",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/set-expo-ip.js && expo start",
    "android": "node scripts/set-expo-ip.js && expo start --android",
    "ios": "node scripts/set-expo-ip.js && expo start --ios",
    "web": "node scripts/set-expo-ip.js && expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.10",
    "@supabase/supabase-js": "^2.76.1",
    "axios": "^1.12.2",
    "date-fns": "^2.30.0",
    "expo": "~54.0.24",
    "expo-apple-authentication": "~8.0.7",
    "expo-auth-session": "~7.0.9",
    "expo-av": "~16.0.7",
    "expo-camera": "^17.0.8",
    "expo-crypto": "~15.0.7",
    "expo-haptics": "^15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-mail-composer": "^15.0.7",
    "expo-media-library": "^18.2.0",
    "expo-notifications": "^0.32.13",
    "expo-status-bar": "~3.0.8",
    "expo-video": "^3.0.14",
    "expo-web-browser": "~15.0.8",
    "firebase": "^12.4.0",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
