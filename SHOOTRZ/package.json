{
  "name": "shootrz-basketball-training",
  "version": "1.0.0",
  "description": "AI-Powered Basketball Training Assistant - Perfect the Game",
  "author": "SHOOTRZ Team",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/set-expo-ip.js && expo start",
    "android": "node scripts/set-expo-ip.js && expo start --android",
    "ios": "node scripts/set-expo-ip.js && expo start --ios",
    "web": "node scripts/set-expo-ip.js && expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contract": "jest -- src/theme/__tests__/tokens.contract.test.ts",
    "lint": "eslint App.tsx src",
    "lint:fix": "eslint App.tsx src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@supabase/supabase-js": "^2.76.1",
    "axios": "^1.12.2",
    "date-fns": "^2.30.0",
    "expo": "^55.0.24",
    "expo-auth-session": "~55.0.16",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-crypto": "~55.0.15",
    "expo-file-system": "~55.0.20",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-mail-composer": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.17",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
